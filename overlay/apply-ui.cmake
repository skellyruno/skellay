if(NOT DEFINED SOURCE_DIR)
 message(FATAL_ERROR "Set SOURCE_DIR")
endif()
file(COPY "${CMAKE_CURRENT_LIST_DIR}/../ui/Rack.h" DESTINATION "${SOURCE_DIR}/plugin")
file(READ "${SOURCE_DIR}/plugin/Skellay.cpp" plugin)
string(FIND "${plugin}" "#include \"Rack.h\"" already)
if(already EQUAL -1)
 string(FIND "${plugin}" "class Editor final:" start)
 string(FIND "${plugin}" "juce::AudioProcessorEditor* Processor::createEditor()" end)
 if(start LESS 0 OR end LESS_EQUAL start)
  message(FATAL_ERROR "Unexpected v0.7 editor layout")
 endif()
 string(SUBSTRING "${plugin}" 0 ${start} prefix)
 string(SUBSTRING "${plugin}" ${end} -1 suffix)
 file(READ "${CMAKE_CURRENT_LIST_DIR}/EditorAdapter.inc" editor)
 file(WRITE "${SOURCE_DIR}/plugin/Skellay.cpp" "#include \"Rack.h\"\n${prefix}${editor}\n${suffix}")
endif()
