# Apply integration-only overlay to the exact verified v0.3 private source.
if(NOT DEFINED SOURCE_DIR)
  message(FATAL_ERROR "Set SOURCE_DIR")
endif()
file(COPY "${CMAKE_CURRENT_LIST_DIR}/ProjectState.h" DESTINATION "${SOURCE_DIR}/native")
file(COPY "${CMAKE_CURRENT_LIST_DIR}/project_state.cpp" DESTINATION "${SOURCE_DIR}/tests")
file(READ "${SOURCE_DIR}/CMakeLists.txt" build)
string(FIND "${build}" "add_executable(project_state" exists)
if(exists EQUAL -1)
  file(APPEND "${SOURCE_DIR}/CMakeLists.txt" "\nadd_executable(project_state tests/project_state.cpp)\ntarget_link_libraries(project_state PRIVATE skellay_native)\nadd_test(NAME project_state COMMAND project_state)\n")
endif()
file(READ "${SOURCE_DIR}/plugin/Skellay.cpp" plugin)
string(FIND "${plugin}" "#include \"ProjectState.h\"" applied)
if(applied EQUAL -1)
  string(REPLACE "#include \"PresetImport.h\"" "#include \"PresetImport.h\"\n#include \"ProjectState.h\"" plugin "${plugin}")
  string(FIND "${plugin}" " void getStateInformation(" start)
  string(FIND "${plugin}" "\n};\nclass Editor" end)
  if(start LESS 0 OR end LESS_EQUAL start)
    message(FATAL_ERROR "Unexpected v0.3 wrapper layout")
  endif()
  string(SUBSTRING "${plugin}" 0 ${start} prefix)
  string(SUBSTRING "${plugin}" ${end} -1 suffix)
  set(plugin "${prefix} void getStateInformation(juce::MemoryBlock& dest)override{\n  std::lock_guard<std::mutex> g(lock);auto bytes=encodeProject(ProjectState{active,configs});dest.reset();if(!bytes.empty())dest.append(bytes.data(),bytes.size());\n }\n void setStateInformation(const void* data,int n)override{\n  if(n<0)return;std::lock_guard<std::mutex> g(lock);auto next=decodeProject(data,size_t(n),ProjectState{active,configs});if(!next)return;configs=std::move(next->engines);active=next->active;++revision;\n }${suffix}")
  string(REPLACE "option(\"Pattern steps\",0,3,21)" "option(\"Pattern steps\",0,std::max(128,get(c,o+21)),21)" plugin "${plugin}")
  file(WRITE "${SOURCE_DIR}/plugin/Skellay.cpp" "${plugin}")
endif()
