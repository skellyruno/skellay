if(NOT DEFINED SOURCE_DIR)
 message(FATAL_ERROR "Set SOURCE_DIR")
endif()
function(patch path old new)
 file(READ "${SOURCE_DIR}/${path}" data)
 string(FIND "${data}" "${new}" done)
 if(NOT done EQUAL -1)
  return()
 endif()
 string(FIND "${data}" "${old}" found)
 if(found EQUAL -1)
  message(FATAL_ERROR "Unexpected source in ${path}")
 endif()
 string(REPLACE "${old}" "${new}" data "${data}")
 file(WRITE "${SOURCE_DIR}/${path}" "${data}")
endfunction()
